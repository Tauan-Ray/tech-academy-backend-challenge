# Database
quarkus.datasource.db-kind=postgresql
quarkus.hibernate-orm.database.generation=validate

# Flyway
quarkus.flyway.migrate-at-start=true

# Gera OpenAPI JSON
mp.openapi.path=/openapi

# Swagger UI
quarkus.swagger-ui.path=/docs
quarkus.swagger-ui.url=/openapi

# Profile DEV
%dev.quarkus.datasource.username=postgres
%dev.quarkus.datasource.password=postgres
%dev.quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:5432/db

%dev.quarkus.http.port=8080

%dev.quarkus.rest-client.grades-api.url=http://localhost:8081

%dev.mp.openapi.extensions.smallrye.generate-always=true
%dev.quarkus.swagger-ui.always-include=true

# Profile PROD (Docker)
%prod.quarkus.datasource.username=${STUDENTS_SERVICE_DB_USER}
%prod.quarkus.datasource.password=${STUDENTS_SERVICE_DB_PASSWORD}
%prod.quarkus.datasource.jdbc.url=jdbc:postgresql://students-service-database:5432/${STUDENTS_SERVICE_DB}

%prod.quarkus.rest-client.grades-api.url=http://grades-service-api:8080

%prod.mp.openapi.extensions.smallrye.generate-always=false
%prod.quarkus.swagger-ui.always-include=false